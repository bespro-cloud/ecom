# =============================================================================
# Health Commerce — environment configuration
# =============================================================================
#
# Copy to .env for local development:  cp .env.example .env
# Then generate real key material:     openssl rand -base64 32
#
# NEVER commit a real .env. In production these values come from a secret
# manager, injected at container start — not from a file on disk.
#
# The API validates all of this at boot and refuses to start if anything is
# missing or unsafe (see packages/config/src/env.ts). That is deliberate: a
# misconfiguration should be a loud, immediate failure, not a subtle one a
# customer discovers.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=health-commerce

# Public, browser-visible URLs. Must be https in production.
API_PUBLIC_URL=http://localhost:4000
STOREFRONT_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

API_PORT=4000
WORKER_PORT=4100

# Address the Next.js servers use to reach the API across the private network.
# Never exposed to the browser.
API_INTERNAL_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# Human-readable output for local work. Always false in production — log
# aggregation needs JSON.
LOG_PRETTY=true

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://healthcommerce:healthcommerce@localhost:5432/health_commerce?schema=public
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Used by docker-compose to initialise the container.
POSTGRES_USER=healthcommerce
POSTGRES_PASSWORD=healthcommerce
POSTGRES_DB=health_commerce

# -----------------------------------------------------------------------------
# Cache and queues
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Namespaces every key, including the BullMQ queues. Two environments sharing a
# Redis instance MUST use different prefixes or they will consume each other's
# jobs.
REDIS_KEY_PREFIX=hc
# Required in production.
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Cryptographic keys
# -----------------------------------------------------------------------------
# Both must decode to at least 32 bytes; generate with `openssl rand -base64 32`.
# Rotate through the documented procedure — see docs/security/SECURITY.md.

# Signs short-lived access tokens and MFA challenge tokens. Rotating it signs
# everyone out, which is the intended behaviour after a suspected compromise.
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_32

# AES-256-GCM key protecting TOTP secrets at rest. Rotating it WITHOUT
# re-encrypting existing factors makes every enrolled second factor unusable.
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Sessions and cookies
# -----------------------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MFA_CHALLENGE_TTL_SECONDS=300
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_VERIFICATION_TTL_SECONDS=259200
STAFF_INVITE_TTL_SECONDS=604800

# Shared parent domain in production, e.g. .example.com. Leave unset locally.
COOKIE_DOMAIN=
# Cannot be false in production.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# CORS and rate limiting
# -----------------------------------------------------------------------------
# Explicit origins only. A wildcard is refused in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=10
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900

# -----------------------------------------------------------------------------
# Commercial defaults
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=US
DEFAULT_TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# Object storage (product images, documents, compliance evidence)
# -----------------------------------------------------------------------------
# "filesystem" is a development convenience and is refused in production; use
# "s3" against AWS S3, MinIO or any S3-compatible service.
STORAGE_PROVIDER=filesystem
STORAGE_FILESYSTEM_ROOT=./data/media

# Where stored objects are served from. Leave unset in development and the API
# signs its own short-lived URLs; set it to the CDN origin in production.
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_UPLOAD_BYTES=15728640
MEDIA_SIGNED_URL_TTL_SECONDS=300

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=health-commerce
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Required for MinIO; usually false for AWS S3.
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# console | smtp | resend | ses
# `console` writes to the log instead of sending; it is refused in production.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.test
EMAIL_API_KEY=
SMTP_URL=

# -----------------------------------------------------------------------------
# SMS
# -----------------------------------------------------------------------------
SMS_PROVIDER=console
SMS_API_KEY=
SMS_FROM=

# -----------------------------------------------------------------------------
# Payments (Phase 3)
# -----------------------------------------------------------------------------
# `mock` is a development adapter and is refused in production. Card data never
# touches this application: the provider's hosted fields collect it, and only a
# provider reference is stored.
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
# Required whenever a real provider is configured — webhooks are verified, never
# trusted.
PAYMENT_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Fulfilment / 3PL (Phase 3)
# -----------------------------------------------------------------------------
FULFILLMENT_PROVIDER=mock
THREEPL_API_KEY=
THREEPL_API_SECRET=

# -----------------------------------------------------------------------------
# AI (Phase 7)
# -----------------------------------------------------------------------------
# Off by default, and "off" is a fully supported production configuration —
# nothing in the platform depends on AI. It may draft and summarise; it may
# never approve a claim, change compliance status, publish, or issue a refund.
#
# disabled | development | anthropic
# `development` is a stand-in that exercises the guardrails and the audit trail
# without an API key. Production refuses it, the same way it refuses the mock
# payment provider.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_MS=30000

# Spend ceiling for one UTC day, in micros (hundredths of a cent). An enabled
# provider with no budget is refused at boot: a metered API with no ceiling is
# an incident waiting for a retry loop.
AI_DAILY_BUDGET_MICROS=0
AI_RATE_LIMIT_PER_HOUR=60

# Provider list price per million tokens, in micros. Used to record what each
# call cost; it does not change what is billed.
AI_INPUT_PRICE_MICROS=300000
AI_OUTPUT_PRICE_MICROS=1500000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true

# -----------------------------------------------------------------------------
# Backups (production)
# -----------------------------------------------------------------------------
# age public key. Backups are encrypted before leaving the host; the script
# refuses to run without this.
BACKUP_AGE_RECIPIENT=
BACKUP_S3_BUCKET=

# -----------------------------------------------------------------------------
# Development seed passwords (optional)
# -----------------------------------------------------------------------------
# The seed uses clearly-marked defaults when these are unset. It refuses to run
# at all when NODE_ENV=production.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_COMPLIANCE_PASSWORD=
SEED_CUSTOMER_PASSWORD=
