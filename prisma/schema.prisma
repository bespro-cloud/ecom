// Health Commerce — database schema
//
// Scope note: this schema currently covers the Phase 1 foundation (identity,
// RBAC, MFA, sessions, customers, audit and operational tables). Commerce,
// catalogue and compliance domains are introduced in later phases via
// additive migrations. See docs/architecture/ROADMAP.md.
//
// Conventions
//  - Primary keys are UUID v4 generated by the database (gen_random_uuid).
//  - Every table carries created_at / updated_at.
//  - deleted_at exists only where soft deletion is safe. Financial,
//    compliance and audit records are never soft-deleted.
//  - Money is never stored as a float: integer minor units + ISO currency.

generator client {
  provider        = "prisma-client-js"
  output          = "../packages/database/generated/client"
  binaryTargets   = ["native"]
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserType {
  STAFF
  CUSTOMER
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique
  emailNormalized   String     @unique @map("email_normalized")
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash      String?    @map("password_hash")
  passwordAlgorithm String?    @map("password_algorithm")
  passwordUpdatedAt DateTime?  @map("password_updated_at") @db.Timestamptz(6)
  firstName         String?    @map("first_name")
  lastName          String?    @map("last_name")
  phone             String?
  type              UserType   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)

  // Credential-stuffing / brute-force protection.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastLoginIp      String?   @map("last_login_ip")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  roles         UserRole[]
  sessions      UserSession[]
  mfaFactors    UserMfaFactor[]
  recoveryCodes UserMfaRecoveryCode[]
  customer      Customer?
  auditLogs     AuditLog[]            @relation("AuditActor")
  tokens        UserToken[]

  @@index([status])
  @@index([type, status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique
  name        String
  description String?
  // System roles are managed by migrations/seed and cannot be deleted or
  // renamed through the admin API.
  isSystem    Boolean @default(false) @map("is_system")
  // Roles that unlock privileged actions must be protected by MFA.
  requiresMfa Boolean @default(false) @map("requires_mfa")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String  @unique
  resource    String
  action      String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  ROTATED
  REUSE_DETECTED
  PASSWORD_CHANGED
  ADMIN_REVOKED
  MFA_ENROLLED
  EXPIRED
}

/// One row per refresh-token issuance. Refresh tokens are opaque random
/// values; only a SHA-256 hash is persisted. Rotation creates a new row and
/// links it via `rotatedToId`, so replay of a consumed token is detectable and
/// revokes the whole family.
model UserSession {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  familyId         String                   @map("family_id") @db.Uuid
  refreshTokenHash String                   @unique @map("refresh_token_hash")
  issuedAt         DateTime                 @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime?                @map("last_used_at") @db.Timestamptz(6)
  rotatedToId      String?                  @unique @map("rotated_to_id") @db.Uuid
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revokedReason    SessionRevocationReason? @map("revoked_reason")
  mfaSatisfied     Boolean                  @default(false) @map("mfa_satisfied")

  // Coarse device attribution for the "active sessions" screen. IP is stored
  // truncated (see SessionService) — we do not need full precision.
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedTo   UserSession? @relation("SessionRotation", fields: [rotatedToId], references: [id], onDelete: SetNull)
  rotatedFrom UserSession? @relation("SessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("user_sessions")
}

enum MfaFactorType {
  TOTP
}

enum MfaFactorStatus {
  PENDING
  ACTIVE
  REVOKED
}

model UserMfaFactor {
  id     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String          @map("user_id") @db.Uuid
  type   MfaFactorType   @default(TOTP)
  status MfaFactorStatus @default(PENDING)
  label  String?

  /// AES-256-GCM ciphertext of the TOTP shared secret, keyed by
  /// ENCRYPTION_KEY. Never returned by any API.
  secretCiphertext String @map("secret_ciphertext")

  /// Last accepted TOTP counter, used to reject replay of the same code.
  lastUsedCounter BigInt? @map("last_used_counter")

  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("user_mfa_factors")
}

model UserMfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("user_mfa_recovery_codes")
}

enum UserTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  STAFF_INVITE
}

/// Single-use, hashed, short-lived tokens for out-of-band flows.
model UserToken {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       UserTokenType
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, consumedAt])
  @@index([expiresAt])
  @@map("user_tokens")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model Customer {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// Human-readable, non-guessable public reference used in emails/support.
  reference String @unique

  acceptsMarketingEmail Boolean @default(false) @map("accepts_marketing_email")
  acceptsMarketingSms   Boolean @default(false) @map("accepts_marketing_sms")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  consents  CustomerConsent[]

  @@index([createdAt])
  @@map("customers")
}

enum AddressType {
  SHIPPING
  BILLING
}

model CustomerAddress {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  type       AddressType @default(SHIPPING)
  label      String?

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  company    String?
  line1      String
  line2      String?
  city       String
  /// Two-letter USPS state/territory code for US addresses.
  region     String
  postalCode String  @map("postal_code")
  /// ISO 3166-1 alpha-2. Only "US" is serviceable today; the column keeps the
  /// model open for later markets.
  country    String  @default("US")
  phone      String?

  isDefaultShipping Boolean @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean @default(false) @map("is_default_billing")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, deletedAt])
  @@map("customer_addresses")
}

enum ConsentType {
  MARKETING_EMAIL
  MARKETING_SMS
  TERMS_OF_SERVICE
  PRIVACY_POLICY
}

/// Append-only consent ledger. Withdrawal is recorded as a new row with
/// granted=false; rows are never updated or deleted.
model CustomerConsent {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String      @map("customer_id") @db.Uuid
  type            ConsentType
  granted         Boolean
  /// Version identifier of the policy text the customer agreed to.
  documentVersion String?     @map("document_version")
  source          String?
  ipAddress       String?     @map("ip_address")
  userAgent       String?     @map("user_agent")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type, createdAt])
  @@map("customer_consents")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  SYSTEM
  JOB
  AI_AGENT
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

/// Append-only. The application role has no UPDATE/DELETE grant on this table
/// (see migration `audit_log_append_only`).
model AuditLog {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id") @db.Uuid
  actorLabel String?        @map("actor_label")

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  outcome AuditOutcome @default(SUCCESS)
  reason  String?

  /// Redacted snapshots. Secrets and payment data must never reach these.
  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  ipAddress     String? @map("ip_address")
  userAgent     String? @map("user_agent")
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model SystemSetting {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @unique
  value       Json
  valueType   SettingValueType @map("value_type")
  description String?
  /// Secret settings are never returned to any client; only referenced
  /// server-side. Real secrets belong in the secret manager, not here.
  isSecret    Boolean          @default(false) @map("is_secret")
  updatedBy   String?          @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

model FeatureFlag {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String   @unique
  description        String?
  enabled            Boolean  @default(false)
  /// 0-100. Deterministic bucketing on a stable subject key.
  rolloutPercentage  Int      @default(0) @map("rollout_percentage")
  /// Explicit allow-list of subject keys (user id / customer id) that always
  /// receive the flag regardless of rollout percentage.
  enabledForSubjects String[] @default([]) @map("enabled_for_subjects")
  updatedBy          String?  @map("updated_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

/// Generic inbound webhook ledger providing idempotency for every provider.
/// (provider, externalId) is unique, so a redelivered event is never processed
/// twice.
model WebhookEvent {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  externalId  String             @map("external_id")
  eventType   String             @map("event_type")
  status      WebhookEventStatus @default(RECEIVED)
  payload     Json
  signature   String?
  attempts    Int                @default(0)
  lastError   String?            @map("last_error")
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, externalId])
  @@index([status, receivedAt])
  @@index([provider, eventType])
  @@map("webhook_events")
}

/// Outbound side of the transactional-outbox pattern: domain events are
/// written in the same transaction as the state change, then dispatched to
/// queues by the worker.
model OutboxMessage {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  correlationId String?   @map("correlation_id")
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  failedAt      DateTime? @map("failed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([dispatchedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_messages")
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  DOCUMENT
}

/// A file in object storage.
///
/// Binary data is never stored in PostgreSQL — only the storage key and the
/// metadata needed to serve, deduplicate and audit it. `checksum` is the
/// SHA-256 of the bytes, which is what makes re-uploading the same file a
/// no-op rather than a second copy.
model Media {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             MediaKind @default(IMAGE)
  storageKey       String    @unique @map("storage_key")
  bucket           String
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  checksum         String
  /// Null for documents and for images whose dimensions could not be read.
  width            Int?
  height           Int?
  originalFilename String?   @map("original_filename")
  uploadedBy       String?   @map("uploaded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  productImages ProductImage[]
  seoImages     SeoMetadata[]

  @@index([checksum])
  @@index([kind, createdAt])
  @@map("media")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Regulatory category. Not cosmetic: a supplement, a cosmetic and a device
/// carry materially different labelling and claim obligations, and the system
/// must never flatten them into "product".
enum ProductType {
  SUPPLEMENT
  COSMETIC
  FOOD
  DEVICE
  WELLNESS
  ACCESSORY
}

enum ProductStatus {
  DRAFT
  IN_REVIEW
  READY
  PUBLISHED
  ARCHIVED
}

/// Compliance state of a product listing.
///
/// Phase 2 implements the gate and a recorded human sign-off. Phase 4 attaches
/// claims, evidence and review items to it; the states do not change.
enum ComplianceStatus {
  NOT_REVIEWED
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model Product {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SKUs are never recycled — they appear on orders, invoices and 3PL
  /// manifests, so reuse would make historical records ambiguous.
  sku  String @unique
  /// Unique among live rows only; see the partial index in the
  /// catalogue_search_and_constraints migration.
  slug String

  name             String
  shortDescription String? @map("short_description")
  longDescription  String? @map("long_description")

  type ProductType

  brand           String?
  manufacturer    String?
  /// ISO 3166-1 alpha-2 country of origin.
  countryOfOrigin String? @map("country_of_origin")

  status                ProductStatus    @default(DRAFT)
  complianceStatus      ComplianceStatus @default(NOT_REVIEWED) @map("compliance_status")
  complianceApprovedAt  DateTime?        @map("compliance_approved_at") @db.Timestamptz(6)
  complianceApprovedBy  String?          @map("compliance_approved_by") @db.Uuid
  /// Approvals expire so a listing reviewed years ago does not stay live by
  /// default. Driven by `compliance.claims_review_interval_days`.
  complianceReviewDueAt DateTime?        @map("compliance_review_due_at") @db.Timestamptz(6)

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  /// Money is integer minor units. A float price is not an acceptable
  /// property for anything a customer is charged.
  priceCents          Int    @map("price_cents")
  compareAtPriceCents Int?   @map("compare_at_price_cents")
  costCents           Int?   @map("cost_cents")
  currency            String @default("USD")

  taxable Boolean @default(true)
  /// Provider-specific tax classification (e.g. a TaxJar or Avalara code).
  taxCode String? @map("tax_code")

  weightGrams Int? @map("weight_grams")
  lengthMm    Int? @map("length_mm")
  widthMm     Int? @map("width_mm")
  heightMm    Int? @map("height_mm")

  requiresShipping     Boolean @default(true) @map("requires_shipping")
  subscriptionEligible Boolean @default(false) @map("subscription_eligible")

  /// Denormalised text (ingredient and category names) folded into the search
  /// vector. Maintained by the application in the same transaction as the
  /// relationships it summarises.
  searchKeywords String? @map("search_keywords")

  /// Stored generated column, maintained by PostgreSQL. Declared here so
  /// `prisma migrate diff` does not see the database as drifted; the client
  /// can neither read nor write it, which is correct — it is queried through
  /// raw SQL in the search provider.
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  variants          ProductVariant[]
  images            ProductImage[]
  categories        ProductCategory[]
  ingredients       ProductIngredient[]
  attributeValues   ProductAttributeValue[]
  warnings          ProductWarning[]
  disclaimers       ProductDisclaimer[]
  complianceReviews ComplianceReview[]
  orderItems        OrderItem[]

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([complianceStatus])
  @@index([brand])
  @@index([createdAt])
  @@map("products")
}

model ProductVariant {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String @map("product_id") @db.Uuid

  sku     String  @unique
  name    String
  /// Retail barcode (UPC/EAN/GTIN), used by 3PLs and marketplaces.
  barcode String?

  /// Null means "inherit the product price". Storing a null rather than a copy
  /// stops a variant silently keeping a stale price after the product changes.
  priceCents          Int? @map("price_cents")
  compareAtPriceCents Int? @map("compare_at_price_cents")
  costCents           Int? @map("cost_cents")

  weightGrams Int? @map("weight_grams")

  /// Option values, e.g. { "size": "60 capsules", "flavour": "unflavoured" }.
  options Json @default("{}")

  position Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  inventory  InventoryItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId, position])
  @@map("product_variants")
}

enum ProductImageRole {
  HERO
  GALLERY
  /// The product label. Required before a supplement can be published.
  LABEL
  /// Supplement Facts / Nutrition Facts panel.
  FACTS_PANEL
  CERTIFICATE
}

model ProductImage {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  variantId String? @map("variant_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid

  role     ProductImageRole @default(GALLERY)
  /// Required. An image with no alternative text is inaccessible, and the
  /// publishing checklist refuses it.
  altText  String           @map("alt_text")
  position Int              @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([productId, position])
  @@index([variantId])
  @@index([mediaId])
  @@map("product_images")
}

model Category {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId String? @map("parent_id") @db.Uuid

  /// Unique among live rows only; see the partial index in the migration.
  slug        String
  name        String
  description String?

  /// Materialised path of ancestor ids, root first. Makes "everything under
  /// this category" a single indexed query instead of a recursive walk.
  path     String[] @default([])
  depth    Int      @default(0)
  position Int      @default(0)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([parentId, position])
  @@index([isActive])
  @@map("categories")
}

model ProductCategory {
  productId  String  @map("product_id") @db.Uuid
  categoryId String  @map("category_id") @db.Uuid
  /// Drives breadcrumbs and the canonical URL when a product sits in several
  /// categories.
  isPrimary  Boolean @default(false) @map("is_primary")
  position   Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

/// Definition of a filterable product attribute (e.g. "form", "vegan",
/// "servings"). Kept separate from values so the facet list can be built
/// without scanning every product.
model ProductAttribute {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String        @unique
  label         String
  type          AttributeType @default(TEXT)
  unit          String?
  /// Whether this attribute appears as a storefront filter.
  isFilterable  Boolean       @default(false) @map("is_filterable")
  position      Int           @default(0)
  /// Permitted values when `type` is ENUM.
  allowedValues String[]      @default([]) @map("allowed_values")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  values ProductAttributeValue[]

  @@map("product_attributes")
}

model ProductAttributeValue {
  productId   String @map("product_id") @db.Uuid
  attributeId String @map("attribute_id") @db.Uuid

  /// Canonical string form, used for faceting and equality filters.
  value        String
  /// Populated for NUMBER attributes so range filters can use an index.
  numericValue Decimal? @map("numeric_value") @db.Decimal(14, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([productId, attributeId])
  @@index([attributeId, value])
  @@index([attributeId, numericValue])
  @@map("product_attribute_values")
}

// ---------------------------------------------------------------------------
// Ingredients
// ---------------------------------------------------------------------------

/// An ingredient, reusable across products.
///
/// Deliberately a first-class entity rather than free text on a product: a
/// recall, a supplier change or a newly-identified interaction has to be
/// answerable as "which products contain this?", and that is only possible if
/// the relationship is modelled.
model Ingredient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique among live rows only; see the partial index in the migration.
  slug           String
  name           String
  /// Binomial or INCI name where one exists.
  scientificName String?  @map("scientific_name")
  commonNames    String[] @default([]) @map("common_names")
  description    String?
  /// CAS registry number, where the substance has one.
  casNumber      String?  @map("cas_number")

  /// Major allergen under the US FALCPA/FASTER list, if applicable.
  allergen   String?
  isAllergen Boolean @default(false) @map("is_allergen")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  sources  IngredientSource[]
  warnings IngredientWarning[]
  products ProductIngredient[]

  @@index([isAllergen])
  @@index([name])
  @@map("ingredients")
}

enum IngredientSourceType {
  PLANT
  ANIMAL
  MINERAL
  SYNTHETIC
  FERMENTATION
  MICROBIAL
  OTHER
}

model IngredientSource {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId  String               @map("ingredient_id") @db.Uuid
  type          IngredientSourceType
  description   String?
  /// Country the material is sourced from, where known.
  originCountry String?              @map("origin_country")
  supplier      String?

  isVegan      Boolean @default(false) @map("is_vegan")
  isVegetarian Boolean @default(false) @map("is_vegetarian")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@map("ingredient_sources")
}

enum WarningSeverity {
  INFORMATION
  CAUTION
  WARNING
}

enum WarningAudience {
  GENERAL
  PREGNANCY
  NURSING
  CHILDREN
  MEDICATION_INTERACTION
  ALLERGY
  MEDICAL_CONDITION
}

/// A warning attached to an ingredient. Inherited by every product containing
/// it, so adding a warning here surfaces on every affected listing rather than
/// requiring each one to be edited.
model IngredientWarning {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ingredientId String          @map("ingredient_id") @db.Uuid
  severity     WarningSeverity @default(CAUTION)
  audience     WarningAudience @default(GENERAL)
  text         String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId, severity])
  @@map("ingredient_warnings")
}

model ProductIngredient {
  productId    String @map("product_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid

  /// Amount per serving, in `unit`. Null where the formulation does not
  /// disclose it (a proprietary blend), which is itself worth showing.
  amount            Decimal? @db.Decimal(14, 4)
  unit              String?
  /// Percent Daily Value, where one is established.
  dailyValuePercent Decimal? @map("daily_value_percent") @db.Decimal(6, 2)

  /// Active ingredients appear in the Supplement Facts panel; others are
  /// excipients listed separately.
  isActive Boolean @default(true) @map("is_active")
  position Int     @default(0)
  notes    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

// ---------------------------------------------------------------------------
// Product safety copy
// ---------------------------------------------------------------------------

/// A warning written specifically for this product, over and above those
/// inherited from its ingredients.
model ProductWarning {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  severity  WarningSeverity @default(WARNING)
  audience  WarningAudience @default(GENERAL)
  text      String
  position  Int             @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_warnings")
}

enum DisclaimerKind {
  /// DSHEA statement required on dietary supplement listings.
  DSHEA
  /// "Not medical advice", "consult your clinician" and similar.
  GENERAL_HEALTH
  ALLERGEN
  OTHER
}

/// Required legal text on a listing. Held as rows rather than hard-coded so
/// counsel can change the wording without a deploy, and so the publishing
/// checklist can verify the required ones are present.
model ProductDisclaimer {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  kind      DisclaimerKind
  text      String
  position  Int            @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, kind])
  @@index([productId, position])
  @@map("product_disclaimers")
}

// ---------------------------------------------------------------------------
// Compliance review (expanded in Phase 4)
// ---------------------------------------------------------------------------

enum ComplianceDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

/// A recorded human sign-off on a product listing.
///
/// Append-only, like the audit log: the credibility of a compliance decision
/// depends entirely on it not having been editable afterwards. Phase 4 adds
/// claims, evidence and per-item review to this; the decision record does not
/// change shape.
model ComplianceReview {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String             @map("product_id") @db.Uuid
  decision  ComplianceDecision
  /// Required. A decision without reasoning is not a review.
  notes     String

  reviewerId    String    @map("reviewer_id") @db.Uuid
  reviewerLabel String    @map("reviewer_label")
  decidedAt     DateTime  @default(now()) @map("decided_at") @db.Timestamptz(6)
  /// When this approval lapses and the listing must be re-reviewed.
  reviewDueAt   DateTime? @map("review_due_at") @db.Timestamptz(6)

  /// Snapshot of the publishing checklist at the moment of the decision, so it
  /// is possible to say what the reviewer actually saw.
  checklistSnapshot Json? @map("checklist_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, decidedAt])
  @@index([decision, decidedAt])
  @@map("compliance_reviews")
}

// ---------------------------------------------------------------------------
// Content and SEO
// ---------------------------------------------------------------------------

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A CMS page.
///
/// Body is stored as structured blocks rather than raw HTML: rendering a block
/// list cannot inject script, whereas storing HTML written in an admin form
/// eventually will.
model Page {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique among live rows only; see the partial index in the migration.
  slug   String
  title  String
  status PageStatus @default(DRAFT)

  /// Array of typed blocks. See packages/validation/src/content.ts.
  blocks Json @default("[]")

  /// Draft content held separately, so editing a live page does not change
  /// what visitors see until it is published.
  draftBlocks Json?   @map("draft_blocks")
  draftTitle  String? @map("draft_title")

  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy  String?   @map("published_by") @db.Uuid
  lastEditedBy String?   @map("last_edited_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([status, publishedAt])
  @@map("pages")
}

enum SeoEntityType {
  PRODUCT
  CATEGORY
  PAGE
  INGREDIENT
}

/// SEO metadata for any entity that has a public URL.
///
/// Polymorphic by (entityType, entityId) rather than a column per domain, so a
/// new public entity type needs no schema change.
model SeoMetadata {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType SeoEntityType @map("entity_type")
  entityId   String        @map("entity_id") @db.Uuid

  title          String?
  description    String?
  canonicalUrl   String? @map("canonical_url")
  ogTitle        String? @map("og_title")
  ogDescription  String? @map("og_description")
  ogImageMediaId String? @map("og_image_media_id") @db.Uuid
  /// Excludes the page from the sitemap and emits a noindex robots directive.
  noindex        Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ogImage Media? @relation(fields: [ogImageMediaId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId])
  @@index([ogImageMediaId])
  @@map("seo_metadata")
}

// ===========================================================================
// Phase 3 — Commerce
//
// Money is always an integer number of minor units. There is no decimal or
// float anywhere in this section: a cent that goes missing to binary rounding
// is a cent that has to be reconciled by a person.
//
// Every monetary total on an order is *stored*, not recomputed on read. A
// customer's invoice must say what they were charged, not what today's prices
// and tax rules would produce.
// ===========================================================================

model Warehouse {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code String @unique
  name String

  line1      String
  line2      String?
  city       String
  region     String
  postalCode String  @map("postal_code")
  country    String  @default("US")

  /// Lower numbers are preferred when allocating stock.
  priority Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  stock       InventoryItem[]
  adjustments InventoryAdjustment[]
  shipments   Shipment[]

  @@index([isActive, priority])
  @@map("warehouses")
}

/// Stock for one variant in one warehouse.
///
/// `onHand` is what is physically there. `reserved` is what is spoken for by
/// carts and unfulfilled orders. Available stock is the difference, and it is
/// derived rather than stored so the two can never disagree.
model InventoryItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId   String @map("variant_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  onHandQuantity   Int @default(0) @map("on_hand_quantity")
  reservedQuantity Int @default(0) @map("reserved_quantity")

  /// Below this, the product is flagged for reordering. Not a sales control.
  reorderPoint   Int     @default(0) @map("reorder_point")
  /// When false, the variant can be sold past zero and back-ordered.
  trackInventory Boolean @default(true) @map("track_inventory")
  allowBackorder Boolean @default(false) @map("allow_backorder")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse    Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reservations InventoryReservation[]
  adjustments  InventoryAdjustment[]

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_items")
}

enum InventoryReservationStatus {
  /// Held for a cart or a checkout in progress.
  HELD
  /// The order was placed; the hold now belongs to the order.
  COMMITTED
  /// Stock left the building. The reservation is closed and on-hand dropped.
  CONSUMED
  /// Released back to available stock.
  RELEASED
  /// Expired without being committed.
  EXPIRED
}

/// A claim on specific stock.
///
/// Reservations exist so two customers cannot buy the last unit. A held
/// reservation expires: an abandoned checkout must not keep stock out of
/// circulation indefinitely.
model InventoryReservation {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId String @map("inventory_item_id") @db.Uuid

  quantity Int
  status   InventoryReservationStatus @default(HELD)

  /// What the reservation is for. Exactly one is set.
  cartId  String? @map("cart_id") @db.Uuid
  orderId String? @map("order_id") @db.Uuid

  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  cart          Cart?         @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, status])
  @@index([cartId])
  @@index([orderId])
  @@index([status, expiresAt])
  @@map("inventory_reservations")
}

enum InventoryAdjustmentReason {
  RECEIPT
  CYCLE_COUNT
  DAMAGE
  EXPIRY
  THEFT
  RETURN
  CORRECTION
  FULFILMENT
}

/// Append-only ledger of every change to on-hand stock.
///
/// Stock levels are a running total; this is the arithmetic behind it. Without
/// the ledger, "we are eleven units short" has no answer.
model InventoryAdjustment {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId String @map("inventory_item_id") @db.Uuid
  warehouseId     String @map("warehouse_id") @db.Uuid

  /// Signed. Negative removes stock.
  quantityDelta   Int @map("quantity_delta")
  /// On-hand after this adjustment, so the ledger can be audited without replay.
  resultingOnHand Int @map("resulting_on_hand")

  reason    InventoryAdjustmentReason
  reference String?
  notes     String?

  actorId    String? @map("actor_id") @db.Uuid
  actorLabel String? @map("actor_label")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([warehouseId, createdAt])
  @@map("inventory_adjustments")
}

enum CartStatus {
  ACTIVE
  /// Converted into an order.
  CONVERTED
  /// Abandoned past the retention window.
  ABANDONED
}

/// A shopping cart.
///
/// A guest cart is addressed by an opaque token held in an httpOnly cookie; it
/// is not addressable by id from the browser. On sign-in the guest cart is
/// merged into the customer's, rather than either being silently discarded.
model Cart {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Opaque bearer token for a guest cart. Null once the cart has an owner.
  token      String? @unique
  customerId String? @map("customer_id") @db.Uuid

  status   CartStatus @default(ACTIVE)
  currency String     @default("USD")

  /// Free-text note from the customer, shown to the warehouse.
  note String?

  /// Snapshot of the last quote, so a page render does not have to reprice.
  /// Authoritative pricing is always recomputed server-side at checkout.
  subtotalCents Int @default(0) @map("subtotal_cents")
  discountCents Int @default(0) @map("discount_cents")
  shippingCents Int @default(0) @map("shipping_cents")
  taxCents      Int @default(0) @map("tax_cents")
  totalCents    Int @default(0) @map("total_cents")

  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  convertedAt DateTime? @map("converted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items        CartItem[]
  reservations InventoryReservation[]
  checkouts    Checkout[]

  @@index([customerId, status])
  @@index([status, updatedAt])
  @@map("carts")
}

model CartItem {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  quantity Int

  /// The price quoted when the item went in, kept so a change can be shown to
  /// the customer rather than silently applied. It is never what they are
  /// charged — checkout reprices from the catalogue.
  quotedUnitPriceCents Int      @map("quoted_unit_price_cents")
  quotedAt             DateTime @default(now()) @map("quoted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

enum CheckoutStatus {
  /// Collecting addresses and a shipping choice.
  OPEN
  /// Totals are locked and a payment intent exists.
  AWAITING_PAYMENT
  /// Payment succeeded; the order has been placed.
  COMPLETED
  /// Abandoned or explicitly cancelled.
  CANCELLED
  /// The hold expired before payment.
  EXPIRED
}

/// One attempt to turn a cart into an order.
///
/// Separate from both cart and order because it is the thing that can be
/// retried. The idempotency key is the customer's guarantee that a double
/// submit, a retried request or a flaky network produces one order rather than
/// two.
model Checkout {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId String @map("cart_id") @db.Uuid

  /// Supplied by the client, unique per checkout attempt.
  idempotencyKey String @unique @map("idempotency_key")

  status   CheckoutStatus @default(OPEN)
  currency String         @default("USD")

  email String?

  /// Addresses are copied in, not referenced: an order must keep the address it
  /// was shipped to even if the customer later edits their address book.
  shippingAddress Json? @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  shippingMethodCode String? @map("shipping_method_code")

  /// Locked totals. Recomputed server-side; never accepted from the client.
  subtotalCents Int @default(0) @map("subtotal_cents")
  discountCents Int @default(0) @map("discount_cents")
  shippingCents Int @default(0) @map("shipping_cents")
  taxCents      Int @default(0) @map("tax_cents")
  totalCents    Int @default(0) @map("total_cents")

  /// A hash of the priced lines. If the cart changes underneath, the customer
  /// is shown the difference instead of being charged the old total.
  pricingFingerprint String? @map("pricing_fingerprint")

  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart     Cart      @relation(fields: [cartId], references: [id], onDelete: Restrict)
  payments Payment[]
  order    Order?

  @@index([cartId, status])
  @@index([status, expiresAt])
  @@map("checkouts")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfilmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

model Order {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Customer-facing reference. Never recycled, never guessable from the id.
  reference String @unique

  checkoutId String? @unique @map("checkout_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid

  /// Kept on the order so a guest order is still reachable, and so a deleted
  /// customer record does not orphan the financial history.
  email String

  status           OrderStatus      @default(PENDING_PAYMENT)
  paymentStatus    PaymentStatus    @default(REQUIRES_PAYMENT)
  fulfilmentStatus FulfilmentStatus @default(UNFULFILLED)

  currency String @default("USD")

  /// Stored totals. An invoice says what was charged, not what today's prices
  /// would produce.
  subtotalCents       Int @map("subtotal_cents")
  discountCents       Int @default(0) @map("discount_cents")
  shippingCents       Int @default(0) @map("shipping_cents")
  taxCents            Int @default(0) @map("tax_cents")
  totalCents          Int @map("total_cents")
  amountPaidCents     Int @default(0) @map("amount_paid_cents")
  amountRefundedCents Int @default(0) @map("amount_refunded_cents")

  shippingAddress Json  @map("shipping_address")
  billingAddress  Json? @map("billing_address")

  shippingMethodCode String? @map("shipping_method_code")
  shippingMethodName String? @map("shipping_method_name")

  customerNote String? @map("customer_note")
  internalNote String? @map("internal_note")

  placedAt    DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkout     Checkout?              @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]
  payments     Payment[]
  refunds      Refund[]
  shipments    Shipment[]
  reservations InventoryReservation[]

  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([email])
  @@map("orders")
}

/// A line on an order.
///
/// Product and variant details are copied in rather than joined at read time.
/// A listing can be renamed, repriced or withdrawn; an order line must still
/// say what was bought and what it cost.
model OrderItem {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  /// Kept for reporting. Restrict on delete, because products are soft-deleted
  /// precisely so historical orders stay readable.
  productId String @map("product_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  sku         String
  productName String @map("product_name")
  variantName String @map("variant_name")

  quantity          Int
  unitPriceCents    Int @map("unit_price_cents")
  /// quantity × unit price, before order-level discount and tax.
  lineSubtotalCents Int @map("line_subtotal_cents")
  discountCents     Int @default(0) @map("discount_cents")
  taxCents          Int @default(0) @map("tax_cents")
  lineTotalCents    Int @map("line_total_cents")

  quantityFulfilled Int @default(0) @map("quantity_fulfilled")
  quantityRefunded  Int @default(0) @map("quantity_refunded")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

/// Append-only history of what happened to an order.
///
/// Enforced by a database trigger. An order timeline that could be edited is
/// not a record of anything, and this is the first place anyone looks when a
/// customer disputes a charge.
model OrderEvent {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  type    String
  message String

  /// Structured context. Never contains card data or full payment credentials.
  data Json?

  actorId    String? @map("actor_id") @db.Uuid
  actorLabel String? @map("actor_label")
  /// True when the system did it rather than a person.
  isSystem   Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// A payment against a checkout and, once placed, an order.
///
/// No card data is stored, ever — not a PAN, not a CVV, not an expiry. The
/// provider's identifiers and the last four digits are the most this table is
/// allowed to hold, and the last four exist only so a customer can recognise
/// which card they used.
model Payment {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutId String? @map("checkout_id") @db.Uuid
  orderId    String? @map("order_id") @db.Uuid

  provider           String
  /// The provider's intent/charge identifier. Unique per provider.
  providerPaymentId  String  @map("provider_payment_id")
  providerCustomerId String? @map("provider_customer_id")

  status   PaymentStatus @default(REQUIRES_PAYMENT)
  currency String        @default("USD")

  amountCents         Int @map("amount_cents")
  amountCapturedCents Int @default(0) @map("amount_captured_cents")
  amountRefundedCents Int @default(0) @map("amount_refunded_cents")

  /// Display only. "visa", "4242". Never enough to charge anything.
  cardBrand String? @map("card_brand")
  cardLast4 String? @map("card_last4")

  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  authorizedAt DateTime? @map("authorized_at") @db.Timestamptz(6)
  capturedAt   DateTime? @map("captured_at") @db.Timestamptz(6)
  failedAt     DateTime? @map("failed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkout Checkout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  refunds  Refund[]

  @@unique([provider, providerPaymentId])
  @@index([checkoutId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundReason {
  REQUESTED_BY_CUSTOMER
  DAMAGED
  NOT_AS_DESCRIBED
  NOT_DELIVERED
  RECALL
  DUPLICATE
  FRAUDULENT
  GOODWILL
  OTHER
}

model Refund {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  paymentId String @map("payment_id") @db.Uuid

  provider         String
  providerRefundId String? @map("provider_refund_id")

  status      RefundStatus @default(PENDING)
  amountCents Int          @map("amount_cents")
  currency    String       @default("USD")

  reason RefundReason
  /// A refund without a stated reason is not auditable. Required by validation.
  notes  String

  /// Which lines this refund covers, when it is line-scoped rather than a
  /// whole-order amount.
  lines Json?

  /// Supplied by the caller so a retried request does not refund twice.
  idempotencyKey String @unique @map("idempotency_key")

  actorId    String @map("actor_id") @db.Uuid
  actorLabel String @map("actor_label")

  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

enum ShipmentStatus {
  PENDING
  LABEL_PURCHASED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  EXCEPTION
}

model Shipment {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  warehouseId String? @map("warehouse_id") @db.Uuid

  provider           String
  providerShipmentId String? @map("provider_shipment_id")

  status  ShipmentStatus @default(PENDING)
  carrier String?
  service String?

  trackingNumber String? @map("tracking_number")
  trackingUrl    String? @map("tracking_url")
  labelUrl       String? @map("label_url")

  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items     ShipmentItem[]

  @@index([orderId])
  @@index([status])
  @@map("shipments")
}

model ShipmentItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shipmentId  String @map("shipment_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid

  quantity Int

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
  @@map("shipment_items")
}

/// A shipping option a customer can choose.
///
/// Rates are configuration, not code: what a business charges for delivery
/// changes without a deploy. The `conditions` column holds the weight and
/// subtotal bounds a rate applies within.
model ShippingRate {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique
  name        String
  description String?

  /// ISO 3166-1 alpha-2 codes, and US state codes for domestic zones.
  countries String[]
  regions   String[]

  priceCents             Int  @map("price_cents")
  /// Above this subtotal the rate is free. Null means never.
  freeAboveSubtotalCents Int? @map("free_above_subtotal_cents")

  minWeightGrams   Int? @map("min_weight_grams")
  maxWeightGrams   Int? @map("max_weight_grams")
  minSubtotalCents Int? @map("min_subtotal_cents")
  maxSubtotalCents Int? @map("max_subtotal_cents")

  estimatedDaysMin Int? @map("estimated_days_min")
  estimatedDaysMax Int? @map("estimated_days_max")

  position Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, position])
  @@map("shipping_rates")
}
