    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@health/config": "workspace:*",
    "@health/types": "workspace:*",
    "nodemailer": "6.10.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/nodemailer": "6.4.17",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
