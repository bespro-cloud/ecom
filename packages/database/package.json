{
  "name": "@health/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "generated"
  ],
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "scripts": {
    "generate": "prisma generate --schema ../../prisma/schema.prisma",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "migrate": "prisma migrate dev --schema ../../prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../../prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema ../../prisma/schema.prisma",
    "reset": "prisma migrate reset --schema ../../prisma/schema.prisma --force",
    "studio": "prisma studio --schema ../../prisma/schema.prisma",
    "seed": "tsx src/seed/index.ts",
    "seed:rbac": "tsx src/seed/rbac-only.ts",
    "test": "vitest run",
    "test:integration": "vitest run",
    "clean": "rm -rf dist .turbo generated"
  },
  "dependencies": {
    "@health/config": "workspace:*",
    "@health/auth": "workspace:*",
    "@health/types": "workspace:*",
    "@prisma/client": "6.2.1"
  },
  "devDependencies": {
    "prisma": "6.2.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
