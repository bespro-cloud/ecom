{
  "name": "@health/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "pnpm run test:unit",
    "test:unit": "jest --config jest.unit.config.cjs",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@health/config": "workspace:*",
    "@health/database": "workspace:*",
    "@health/notifications": "workspace:*",
    "@health/types": "workspace:*",
    "@nestjs/common": "11.0.6",
    "@nestjs/core": "11.0.6",
    "@nestjs/platform-express": "11.0.6",
    "@nestjs/schedule": "5.0.1",
    "@sentry/node": "8.51.0",
    "bullmq": "5.34.10",
    "ioredis": "5.4.2",
    "nestjs-pino": "4.3.0",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.2",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.7",
    "jest": "29.7.0",
    "pino-pretty": "13.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.3"
  }
}
