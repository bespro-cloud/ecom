{
  "name": "@health/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "pnpm run test:unit",
    "test:unit": "jest --config jest.unit.config.cjs",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "openapi": "tsx scripts/generate-openapi.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@health/auth": "workspace:*",
    "@health/config": "workspace:*",
    "@health/database": "workspace:*",
    "@health/types": "workspace:*",
    "@health/validation": "workspace:*",
    "@nestjs/common": "11.0.6",
    "@nestjs/core": "11.0.6",
    "@nestjs/platform-express": "11.0.6",
    "@nestjs/swagger": "11.0.3",
    "@nestjs/terminus": "11.0.0",
    "@sentry/node": "8.51.0",
    "compression": "1.7.5",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "nestjs-pino": "4.3.0",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.2",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.6",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "pino-pretty": "13.0.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
